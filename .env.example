# Python 3.11+. Run: .venv/bin/python -m lightpost
HOST=127.0.0.1
PORT=3000

# Optional on loopback. Required (16+ characters) for a LAN bind.
ADMIN_PASSWORD=

# Optional for a new workspace: an encryption key is generated privately in data/credentials.key.
# Keep the same key when restarting or restoring your workspace.
ENCRYPTION_KEY=

DATABASE_PATH=data/lightpost.sqlite

# Enable only when using HTTPS.
COOKIE_SECURE=false

# Instagram API version used by your Meta developer app:
META_GRAPH_VERSION=v25.0

# LightPost creates an API key for you on first start and keeps it in data/api.key
# (see Settings > Automation). Set this only if you want to choose your own (24+ characters):
API_KEY=
# Set to false to switch the API (/api/v1) and MCP server (/mcp) off completely:
API_ENABLED=true
# Optional: an https address you provide yourself (reverse proxy, Tailscale Funnel, ...)
# that forwards to this server. Leave empty to stay local-only.
PUBLIC_URL=
